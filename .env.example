# Endpoint publico
API_STATIC_TOKEN=change-me-with-a-long-random-token
PUBLIC_BASE_URL=http://localhost:8080

# MCP Server (Clicksign) — usado apenas para o fluxo OAuth2 (DCR + authorize + token)
MCP_SERVER_BASE_URL=https://mcp-api-tavola-v3.clicksign.com
MCP_ENDPOINT_PATH=/mcp/oauth2
MCP_OAUTH_SCOPES=openid email phone

# Clicksign REST API — execução das tools (substitui o MCP `tools/call`)
CLICKSIGN_API_BASE_URL=https://app.clicksign.com/api/v3
CLICKSIGN_HTTP_TIMEOUT_SECONDS=30

# FileFetcher (para create_envelope_with_file_url)
FILE_FETCHER_MAX_BYTES=20971520
FILE_FETCHER_ALLOW_HTTP=false

# OAuth2 / DCR
OAUTH_REDIRECT_PATH=/oauth2/callback
STATE_HMAC_SECRET=change-me-32-bytes-of-random-data-please
PKCE_TTL_SECONDS=300

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOOL_ITERATIONS=8
OPENAI_TIMEOUT_SECONDS=60

# Intent classifier (gate antes do LLM principal)
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=gpt-4o-mini
CLASSIFIER_TIMEOUT_SECONDS=10
CLASSIFIER_CACHE_TTL_SECONDS=60
CLASSIFIER_CONTEXT_TURNS=4

# Meta-help LLM (responde saudacoes/ajuda com naturalidade + tools dinamicas)
META_HELP_ENABLED=true
META_HELP_MODEL=gpt-4o-mini
META_HELP_TIMEOUT_SECONDS=10

# n8n callback (opcional). Recebe eventos como oauth_success / oauth_failed /
# session_expired. Para oauth_success com multi-conta, o payload inclui
# metadata.requires_account_selection=true e metadata.accounts=[{key,name}].
N8N_WEBHOOK_URL=https://n8n-production.clicksign.com/webhook/ivgpN2i4qY5ZbgcO/whatsapp/login/success
N8N_WEBHOOK_TOKEN=
# Logar o body exato enviado ao n8n (uso de debug — pode vazar account keys).
N8N_DEBUG_LOG_PAYLOAD=false

# Storage
SESSION_BACKEND=memory
DYNAMODB_TABLE_NAME=whatsapp_mcp_sessions
DYNAMODB_ENDPOINT=
AWS_REGION=us-east-1

# HTTP
PORT=8080
LOG_LEVEL=info
