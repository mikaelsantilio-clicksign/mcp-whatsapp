# Endpoint publico
API_STATIC_TOKEN=change-me-with-a-long-random-token
PUBLIC_BASE_URL=http://localhost:8080

# MCP Server (Clicksign)
MCP_SERVER_BASE_URL=https://mcp-api-tavola-v3-6.clicksign.dev
MCP_ENDPOINT_PATH=/mcp/oauth2
MCP_OAUTH_SCOPES=openid email phone

# OAuth2 / DCR
OAUTH_REDIRECT_PATH=/oauth2/callback
STATE_HMAC_SECRET=change-me-32-bytes-of-random-data-please
PKCE_TTL_SECONDS=300

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOOL_ITERATIONS=8
OPENAI_TIMEOUT_SECONDS=60

# Intent classifier (gate antes do LLM principal)
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=gpt-4o-mini
CLASSIFIER_TIMEOUT_SECONDS=10
CLASSIFIER_CACHE_TTL_SECONDS=60
CLASSIFIER_CONTEXT_TURNS=4

# Meta-help LLM (responde saudacoes/ajuda com naturalidade + tools dinamicas)
META_HELP_ENABLED=true
META_HELP_MODEL=gpt-4o-mini
META_HELP_TIMEOUT_SECONDS=10

# n8n callback (opcional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Storage
SESSION_BACKEND=memory
DYNAMODB_TABLE_NAME=whatsapp_mcp_sessions
DYNAMODB_ENDPOINT=
AWS_REGION=us-east-1

# HTTP
PORT=8080
LOG_LEVEL=info
