# Endpoint publico
API_STATIC_TOKEN=change-me-with-a-long-random-token
# PUBLIC_BASE_URL: precisa ser https publico para o OAuth Cognito aceitar o
# redirect_uri. Em dev use ngrok; o callback final fica em
# {PUBLIC_BASE_URL}{OAUTH_REDIRECT_PATH}.
PUBLIC_BASE_URL=https://hyperdulic-interruptedly-melania.ngrok-free.dev

# OAuth2 Clicksign — Modo direto (Cognito sem MCP facade) ----------------
# Modo "direct" (padrao): backend autentica direto contra o Cognito da
# Clicksign com um client_id+secret confidencial registrado manualmente.
# Use "mcp" para o modo legado que vai pela fachada MCP com DCR dinamico.
OAUTH_MODE=direct
# Endpoints do Cognito (staging por padrao; troque para
# https://oauth2.clicksign.com em producao).
OAUTH_AUTHORIZE_URL=https://oauth2.clicksign.dev/login
OAUTH_TOKEN_URL=https://oauth2.clicksign.dev/oauth2/token
# Client_id e client_secret emitidos pela Clicksign para esta aplicacao.
# OBRIGATORIOS em modo direct.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid email phone

# OAuth2 — caminho de callback que combina com PUBLIC_BASE_URL para formar
# o redirect_uri completo registrado no Cognito (ex.:
# https://hyperdulic-interruptedly-melania.ngrok-free.dev/oauth2/callback).
OAUTH_REDIRECT_PATH=/oauth2/callback
STATE_HMAC_SECRET=change-me-32-bytes-of-random-data-please
PKCE_TTL_SECONDS=300

# MCP Server (Clicksign) — apenas usado quando OAUTH_MODE=mcp -----------
MCP_SERVER_BASE_URL=https://mcp-api-tavola-v3-6.clicksign.dev
MCP_ENDPOINT_PATH=/mcp/oauth2
MCP_OAUTH_SCOPES=openid email phone

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOOL_ITERATIONS=8
OPENAI_TIMEOUT_SECONDS=60

# Intent classifier (gate antes do LLM principal)
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=gpt-4o-mini
CLASSIFIER_TIMEOUT_SECONDS=10
CLASSIFIER_CACHE_TTL_SECONDS=60
CLASSIFIER_CONTEXT_TURNS=4

# Meta-help LLM (responde saudacoes/ajuda com naturalidade + tools dinamicas)
META_HELP_ENABLED=true
META_HELP_MODEL=gpt-4o-mini
META_HELP_TIMEOUT_SECONDS=10

# n8n callback (opcional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Storage
SESSION_BACKEND=memory
DYNAMODB_TABLE_NAME=whatsapp_mcp_sessions
DYNAMODB_ENDPOINT=
AWS_REGION=us-east-1

# HTTP
PORT=8080
LOG_LEVEL=info

# ---- Option B (NLU + Guided Flow) ----------------------------------
# Pipeline switch: "legacy" (MCP + LLM tool-calling, padrao atual) ou
# "flow" (NLU LLM extrai intent/entities + state machine Go chama a API
# REST da Clicksign diretamente). Veja IMPLEMENTATION_PLAN_OPTION_B.md.
PIPELINE=flow

# Clicksign REST API (usado apenas quando PIPELINE=flow).
# Staging: https://4.clicksign.dev/api/v3
# Producao: https://app.clicksign.com/api/v3
CLICKSIGN_API_BASE_URL=https://4.clicksign.dev/api/v3
CLICKSIGN_API_TIMEOUT_SECONDS=20

# NLU LLM (substitui o LLM principal quando PIPELINE=flow)
NLU_MODEL=gpt-4o-mini
NLU_TIMEOUT_SECONDS=15
